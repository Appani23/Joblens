# ── Adzuna API ────────────────────────────────────────────────────────────────
# Get these at https://developer.adzuna.com/ (free tier works)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ── Anthropic Claude API ──────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Used by resume-service (parsing) and matching-service (scoring) — paid, billed per token
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# ── Gmail SMTP (forgot-password emails) ──────────────────────────────────────
# Only required if you want to test the password-reset email flow.
# Use a Gmail App Password (NOT your account password):
#   Gmail → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FROM_NAME=JobLens
FRONTEND_BASE_URL=http://localhost:5173
